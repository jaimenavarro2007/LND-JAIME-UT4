<?xml version="1.0"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">

<xs:element name="lista">
  <xs:complexType>
    <xs:sequence>
      <xs:element name="nombre" type="xs:string"/>
      <xs:element name="imagen" type="xs:string"/>
      <xs:element name="tarea" maxOccurs="unbounde"/>
        <xs:complexType>
          <xs:sequence>
             <xs:element name="titulo" type="xs:string"/>
             <xs:element name="descripcion" type="xs:string"/>
             <xs:element name="fecha_vencimiento" type="xs:date"/>
          <xs:sequence>
        </xs:complexType>
    </xs:sequence>
  </xs:complexType>
</xs:element>

<xs:element name="tarea">
  <xs:complexType>
    <xs:sequence>
      <xs:element name="titulo" type="xs:string"/>
      <xs:element name="descripcion" type="xs:string"/>
      <xs:element name="fecha_vencimiento" type="xs:date"/>
    </xs:sequence>
    <xs:attribute name="id" type="xs:ID" use="required"/>
  </xs:complexType>
</xs:element>

</xs:schema>