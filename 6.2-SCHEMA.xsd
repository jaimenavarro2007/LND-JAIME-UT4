<?xml version="1.0"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
/*DTD1*/
<xs:element name="BDcomponente">
  <xs:complexType>
    <xs:sequence>
      <xs:element name="componente" type="xs:string"/>
    </xs:sequence>
  </xs:complexType>
</xs:element>

<xs:element name="componente">
  <xs:complexType>
    <xs:sequence>
      <xs:element name="nombre" type="xs:string"/>
      <xs:element name="precio" type="xs:integer"/>
      <xs:simpleType>
          <xs:restriction base="xs:decimal">
             <xs:minInclusive value="0.01"/> 
             <xs:maxInclusive value="9999.99"/>
          </xs:restriction>
      </xs:simpleType>
      <xs:element name="precioigic" type="xs:integer"/>
      <xs:element name="tipo" type="xs:string"/>
      <xs:element name="peso" type="xs:integer"/>
    </xs:sequence>
  </xs:complexType>
</xs:element>

/*DTD2*/
<xs:element name="BDusuarios">
  <xs:complexType>
    <xs:sequence>
      <xs:element name="usuario" type="xs:string"/>
    </xs:sequence>
  </xs:complexType>
</xs:element>

<xs:element name="usuario">
  <xs:complexType>
      <xs:attribute name="clave" type="xs:ID" use="required"/>
      <xs:attribute name="dni" type="xs:ID" use="required"/>
       <xs:simpleType>
            <xs:restriction base="xs:string">
                <xs:minLength value="9"/>
                <xs:maxLength value="9"/> 
            </xs:restriction>
        </xs:simpleType>
    <xs:sequence>
      <xs:element name="nombre" type="xs:string"/>
      <xs:element name="email" type="xs:string"/>
      <xs:element name="fechaNac" type="xs:date"/>
    </xs:sequence>
  </xs:complexType>
</xs:element>


</xs:schema>